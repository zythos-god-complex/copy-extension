{
  "manifest_version": 3,
  "name": "Page Text Copier",
  "version": "0.2.0",
  "description": "Password-gated. Once unlocked, auto-captures text then images from every page (with a short delay) to your clipboard and your private web inbox.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy page text"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy all page text"
    }
  }
}
